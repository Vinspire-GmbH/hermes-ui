# Session cookies. REQUIRED — without it nobody can sign in.
# At least 32 characters. Changing it signs everyone out.
#   openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Where the SQLite file lives. Put it on a volume in production.
HERMES_UI_DB=./.data/hermes-ui.db

# Web Push. Without these, notifications stay switched off rather than
# failing. Set both or neither.
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Token prices for the cost page, USD per million tokens, for models this
# build cannot price. Only a fallback — the figures normally come from Hermes.
#   MODEL_PRICES={"my-model":{"in":3,"out":15,"cacheRead":0.3,"cacheWrite":3.75}}

# How many proxy hops in front of this app you own. Decides which
# X-Forwarded-For entry the rate limiter counts against. Default 1.
#   TRUSTED_PROXY_HOPS=1
