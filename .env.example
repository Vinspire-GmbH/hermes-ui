# Session cookies (at least 32 characters). Required.
# Changing it signs everyone out.
NUXT_SESSION_PASSWORD=

# Where the SQLite file lives. Put it on a volume in production.
HERMES_UI_DB=./.data/hermes-ui.db

# Web Push. Without these, notifications stay switched off rather than
# failing. Generate a pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
