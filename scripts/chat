#!/usr/bin/python3
"""chat — post into the Hermes console as a bot, and ship its accounting.

The counterpart to `--deliver slack:C…`. Hermes can only deliver to the
platforms in its own `Platform` enum, and the console is not one of them, so
the bot reports for itself with its write key. That is how a scheduled run
lands in a channel without anyone having asked.

No third-party libraries, on purpose: a tool call's environment is sanitized
and holds nothing beyond the standard library.

Credentials: $HOME/.config/chat/config.json (0600)
  { "base_url": "https://chat.example.com",
    "token":    "hui-…",
    "channel":  "general" }

The console issues the key: POST /api/bots/<id>/tokens. `channel` is the
default channel and may be omitted; then --channel is required. The German
field name `channel_name` is still read, because that file sits on other people's
servers and a rename should not break a cron run.

See CONNECTING.md for the long version.
"""

import json
import os
import sys
import urllib.error
import urllib.request

HOME = os.environ.get("HOME") or "/opt/data/home"
CONFIG = os.path.join(HOME, ".config", "chat", "config.json")


class ToolError(Exception):
    pass


def config():
    if not os.path.exists(CONFIG):
        raise ToolError(f"No credentials at {CONFIG}. An administrator creates them.")
    with open(CONFIG, encoding="utf-8") as f:
        c = json.load(f)
    for k in ("base_url", "token"):
        if not c.get(k):
            raise ToolError(f"Missing from {CONFIG}: {k}")
    return c


def api(c, path, payload=None):
    url = f"{c['base_url'].rstrip('/')}{path}"
    body = json.dumps(payload).encode("utf-8") if payload is not None else None
    req = urllib.request.Request(url, data=body, method="POST" if body else "GET")
    req.add_header("Authorization", f"Bearer {c['token']}")
    req.add_header("Accept", "application/json")
    if body:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=45) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", "replace")
        try:
            reason = json.loads(raw).get("statusMessage") or json.loads(raw).get("message") or raw
        except Exception:
            reason = raw[:300]
        if e.code == 401:
            raise ToolError(f"The console rejected the key: {reason}")
        raise ToolError(f"Console answered {e.code}: {reason}")
    except urllib.error.URLError as e:
        raise ToolError(f"Console not reachable: {e.reason}")


def cmd_post(args):
    c = config()
    channel_name = args.channel or c.get("channel") or c.get("kanal")
    if not channel_name:
        raise ToolError("No channel given, and none in the configuration.")

    text = " ".join(args.text).strip()
    if not text or text == "-":
        # For long reports: `… | chat post -`. A report with line breaks does
        # not belong in a shell argument.
        text = sys.stdin.read().strip()
    if not text:
        raise ToolError("Nothing to report — the text is empty.")

    payload = {"channel": channel_name, "text": text}
    if args.thread:
        payload["thread"] = args.thread
    a = api(c, "/api/bot/messages", payload)
    print(f"Posted to #{a['channel']} as {a['bot']} ({a['id']}).")


def cmd_channels(args):
    c = config()
    for k in api(c, "/api/bot/channels"):
        print(f"  #{k['slug']:<24} {k['name']}" + (f" — {k['topic']}" if k.get("topic") else ""))


def cmd_usage(args):
    """Ship what the runs cost to the console.

    The source is Hermes' own accounting in state.db, not the cron usage
    audit file. The reason is a mistake that looked expensive: in
    agent/usage_pricing.py, `prompt_tokens` is
    `input_tokens + cache_read_tokens + cache_write_tokens`. Priced at the
    input rate that overstates the bill roughly fivefold — measured on one
    agent, 90 % of the input is cache reads, and those cost a tenth.

    The `sessions` table keeps the four buckets apart and carries
    `estimated_cost_usd`, computed by Hermes with its own price table. It
    also covers both cases: scheduled runs and conversations sit there
    alike. One source instead of two.
    """
    c = config()
    home = os.environ.get("HERMES_HOME") or HOME
    path = args.file or os.path.join(home, "state.db")
    if not os.path.exists(path):
        raise ToolError(f"No state database at {path}.")

    cutoff = 0.0
    if args.days:
        import time as _t
        cutoff = _t.time() - args.days * 86400

    import sqlite3
    # Read-only: the file belongs to the running gateway.
    v = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    v.row_factory = sqlite3.Row
    records = []
    for r in v.execute(
        """SELECT id, source, title, model, api_call_count,
                  input_tokens, cache_read_tokens, cache_write_tokens,
                  output_tokens, estimated_cost_usd, actual_cost_usd,
                  cost_status, started_at
           FROM sessions
           WHERE started_at >= ?
             AND (input_tokens + cache_read_tokens + cache_write_tokens
                  + output_tokens) > 0
           ORDER BY started_at""", (cutoff,)):
        titel = r["title"] or ""
        # A cron session is titled "<job name> · Aug 19 08:17"; the part in
        # front is what the cost page groups by.
        auftrag = titel.split(" · ")[0].strip() if r["source"] == "cron" and " · " in titel else None
        records.append({
            "ref": f"session:{r['id']}",
            "source": r["source"],
            "title": titel[:200] or None,
            "job_name": auftrag,
            "model": r["model"],
            "api_calls": r["api_call_count"] or 0,
            "input_tokens": r["input_tokens"] or 0,
            "cache_read_tokens": r["cache_read_tokens"] or 0,
            "cache_write_tokens": r["cache_write_tokens"] or 0,
            "output_tokens": r["output_tokens"] or 0,
            # actual_cost_usd is set only when the provider reported a real
            # figure; otherwise the estimate is the best there is.
            "cost_usd": r["actual_cost_usd"] if r["actual_cost_usd"] is not None
                        else r["estimated_cost_usd"],
            "cost_status": ("actual" if r["actual_cost_usd"] is not None
                            else (r["cost_status"] or None)),
            "at_epoch": r["started_at"],
        })
    v.close()

    if not records:
        print("Nothing to send.")
        return

    sent = fresh = 0
    for i in range(0, len(records), 300):
        a = api(c, "/api/bot/usage", {"records": records[i:i + 300]})
        sent += a.get("accepted", 0)
        fresh += a.get("stored", 0)
    total = sum(x["cost_usd"] or 0 for x in records)
    print(f"Sent {sent} sessions, {fresh} of them new, {total:.2f} USD in total.")


def main():
    import argparse
    p = argparse.ArgumentParser(prog="chat", description="Post into the Hermes console as a bot.")
    u = p.add_subparsers(dest="command", required=True)

    s = u.add_parser("post", help="post a message into a channel")
    s.add_argument("text", nargs="*", help="the text; '-' or empty reads stdin")
    # Die alten Namen bleiben als Zweitschreibweise: sie stehen in SOUL-Dateien
    # und Cron-Prompts auf Servern, die niemand gleichzeitig mit anfasst.
    s.add_argument("--channel", "--kanal", dest="channel",
                   help="channel name without #; the default is in the configuration")
    s.add_argument("--thread", "--faden", dest="thread",
                   help="id of the message to reply under")

    u.add_parser("channels", aliases=["kanaele"], help="which channels exist")

    v = u.add_parser("usage", help="ship the cost of runs to the console")
    v.add_argument("--days", "--tage", dest="days", type=int,
               help="only runs from the last N days")
    v.add_argument("--file", "--datei", dest="file",
               help="a state database other than HERMES_HOME/state.db")

    args = p.parse_args()
    try:
        {"post": cmd_post, "channels": cmd_channels,
         "kanaele": cmd_channels, "usage": cmd_usage}[args.command](args)
    except ToolError as e:
        print(f"chat: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
