#!/usr/bin/python3
"""chat — als Bot in die Kanäle der Hermes-Oberfläche schreiben.

Das Gegenstück zu `--deliver slack:C…`: Hermes kann von sich aus nur die
Plattformen seines `Platform`-Enums bedienen, und die eigene Oberfläche ist
keine davon. Also meldet sich der Bot selbst, mit seinem Schreibschlüssel —
so kommen Cron-Berichte in einen Kanal, ohne dass jemand gefragt hat.

Ohne Fremdbibliotheken, mit Absicht: die Umgebung eines Werkzeugaufrufs ist
bereinigt, dort gibt es nichts außer der Standardbibliothek.

Zugangsdaten: $HOME/.config/chat/config.json (0600)
  { "base_url": "https://chat.example.com",
    "token":    "hui-…",
    "channel":  "general" }

Den Schlüssel stellt die Oberfläche aus: POST /api/bots/<id>/tokens.
`channel` ist der Standardkanal und darf fehlen; dann ist --channel Pflicht.
Der alte Name `kanal` wird weiter gelesen: die Datei liegt auf fremden
Servern, und ein Cron-Lauf soll nicht an einer Umbenennung scheitern.
Einzelheiten in CONNECTING.md.
"""

import json
import os
import sys
import urllib.error
import urllib.request

HOME = os.environ.get("HOME") or "/opt/data/home"
CONFIG = os.path.join(HOME, ".config", "chat", "config.json")


class Fehler(Exception):
    pass


def config():
    if not os.path.exists(CONFIG):
        raise Fehler(f"Keine Zugangsdaten unter {CONFIG}. Die legt Marcel an.")
    with open(CONFIG, encoding="utf-8") as f:
        c = json.load(f)
    for k in ("base_url", "token"):
        if not c.get(k):
            raise Fehler(f"In {CONFIG} fehlt: {k}")
    return c


def api(c, pfad, daten=None):
    url = f"{c['base_url'].rstrip('/')}{pfad}"
    leib = json.dumps(daten).encode("utf-8") if daten is not None else None
    req = urllib.request.Request(url, data=leib, method="POST" if leib else "GET")
    req.add_header("Authorization", f"Bearer {c['token']}")
    req.add_header("Accept", "application/json")
    if leib:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=45) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        roh = e.read().decode("utf-8", "replace")
        try:
            grund = json.loads(roh).get("statusMessage") or json.loads(roh).get("message") or roh
        except Exception:
            grund = roh[:300]
        if e.code == 401:
            raise Fehler(f"Die Oberfläche weist den Schlüssel ab: {grund}")
        raise Fehler(f"Oberfläche antwortet {e.code}: {grund}")
    except urllib.error.URLError as e:
        raise Fehler(f"Oberfläche nicht erreichbar: {e.reason}")


def cmd_post(args):
    c = config()
    kanal = args.channel or c.get("channel") or c.get("kanal")
    if not kanal:
        raise Fehler("Kein Kanal angegeben und keiner in der Konfiguration.")

    text = " ".join(args.text).strip()
    if not text or text == "-":
        # Für lange Berichte: `… | chat post -`. Ein Bericht mit Zeilenumbrüchen
        # gehört nicht in ein Shell-Argument.
        text = sys.stdin.read().strip()
    if not text:
        raise Fehler("Nichts zu melden — der Text ist leer.")

    daten = {"channel": kanal, "text": text}
    if args.thread:
        daten["thread"] = args.thread
    a = api(c, "/api/bot/messages", daten)
    print(f"Gesendet an #{a['channel']} als {a['bot']} ({a['id']}).")


def cmd_kanaele(args):
    c = config()
    for k in api(c, "/api/bot/channels"):
        print(f"  #{k['slug']:<24} {k['name']}" + (f" — {k['topic']}" if k.get("topic") else ""))


def cmd_usage(args):
    """Verbrauchszahlen der Cron-Läufe an die Oberfläche schicken.

    Hermes schreibt je Lauf eine Zeile nach cron/usage_audit.jsonl — Modell,
    Token, Dauer — und stellt sie über keinen Endpunkt bereit. Ohne diesen
    Weg zeigt eine Kostenansicht nur den Chat und unterschätzt die Rechnung
    deutlich; die geplanten Läufe sind die teuren.

    Die Kennung `fire_id` ist drüben eindeutig, also ist mehrfaches Schicken
    derselben Datei harmlos. Deshalb gibt es hier keine Buchhaltung darüber,
    was schon übertragen wurde: der einfachere Weg ist auch der robustere.
    """
    c = config()
    pfad = args.datei or os.path.join(
        os.environ.get("HERMES_HOME") or HOME, "cron", "usage_audit.jsonl")
    if not os.path.exists(pfad):
        raise Fehler(f"Keine Verbrauchsdatei unter {pfad}.")

    grenze = None
    if args.tage:
        from datetime import datetime, timedelta, timezone
        grenze = datetime.now(timezone.utc) - timedelta(days=args.tage)

    saetze = []
    with open(pfad, encoding="utf-8") as f:
        for zeile in f:
            zeile = zeile.strip()
            if not zeile:
                continue
            try:
                r = json.loads(zeile)
            except Exception:
                continue          # eine kaputte Zeile kippt nicht den Lauf
            if not r.get("fire_id"):
                continue
            if grenze:
                try:
                    from datetime import datetime
                    ts = datetime.fromisoformat(r["ts"].replace("Z", "+00:00"))
                    if ts < grenze:
                        continue
                except Exception:
                    pass
            saetze.append(r)

    if not saetze:
        print("Nichts zu schicken.")
        return

    # In Häppchen, weil der Endpunkt bei 2000 Sätzen abweist und eine
    # jahrealte Datei das überschreiten kann.
    gesamt = neu = 0
    for i in range(0, len(saetze), 500):
        a = api(c, "/api/bot/usage", {"records": saetze[i:i + 500]})
        gesamt += a.get("accepted", 0)
        neu += a.get("stored", 0)
    print(f"{gesamt} Sätze geschickt, {neu} davon neu.")


def main():
    import argparse
    p = argparse.ArgumentParser(prog="chat", description="Als Bot in die Kanäle der Hermes-Oberfläche schreiben.")
    u = p.add_subparsers(dest="befehl", required=True)

    s = u.add_parser("post", help="eine Nachricht in einen Kanal schreiben")
    s.add_argument("text", nargs="*", help="der Text; '-' oder leer liest von stdin")
    # Die alten Namen bleiben als Zweitschreibweise: sie stehen in SOUL-Dateien
    # und Cron-Prompts auf Servern, die niemand gleichzeitig mit anfasst.
    s.add_argument("--channel", "--kanal", dest="channel",
                   help="Kanalname ohne #; Standard steht in der Konfiguration")
    s.add_argument("--thread", "--faden", dest="thread",
                   help="Kennung einer Nachricht, unter die geantwortet wird")

    u.add_parser("channels", aliases=["kanaele"], help="welche Kanäle es gibt")

    v = u.add_parser("usage", help="Verbrauchszahlen der Cron-Läufe übertragen")
    v.add_argument("--tage", type=int, help="nur Läufe der letzten N Tage")
    v.add_argument("--datei", help="andere Verbrauchsdatei als cron/usage_audit.jsonl")

    args = p.parse_args()
    try:
        {"post": cmd_post, "channels": cmd_kanaele,
         "kanaele": cmd_kanaele, "usage": cmd_usage}[args.befehl](args)
    except Fehler as e:
        print(f"chat: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
